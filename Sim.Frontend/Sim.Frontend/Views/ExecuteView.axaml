<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:views="clr-namespace:Sim.Frontend.Views"
             xmlns:viewModels="clr-namespace:Sim.Frontend.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:DataType="viewModels:ExecuteViewViewModel"
             x:Class="Sim.Frontend.Views.ExecuteView">
    <Design.DataContext>
        <viewModels:ExecuteViewViewModel/>
    </Design.DataContext>
    <views:WorkspaceView.PropertiesPanel>
        <Control></Control>
    </views:WorkspaceView.PropertiesPanel>
    <views:WorkspaceView.ExplorerContextMenu>
        <ContextMenu></ContextMenu>
    </views:WorkspaceView.ExplorerContextMenu>
    <views:WorkspaceView.ToolbarPanel>
        <StackPanel Orientation="Horizontal">
            <StackPanel>
                <TextBlock>Choose Runstate</TextBlock>
                <ComboBox SelectedIndex="{Binding SelectedRunstateIndex}"
                          ItemsSource="{Binding RecentRunstates}">
                </ComboBox>
                <Button Command="{Binding NewRunstateCommand}">NEW RS</Button>
                <Button>OPEN RS</Button>
            </StackPanel>
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Button>CrSt</Button>
                </StackPanel>
            </StackPanel>
            <Button Command="{Binding SetRunningCommand}" CommandParameter="{x:True}" 
                    IsVisible="{Binding IsRunning}">RUN</Button>
            <Button Command="{Binding SetRunningCommand}" CommandParameter="{x:False}" 
                    IsVisible="{Binding IsRunning}">STOP</Button>
            <Button>RESET</Button>
            <StackPanel>
                <Button>STEP</Button>
                <NumericUpDown></NumericUpDown>
            </StackPanel>
        </StackPanel>
    </views:WorkspaceView.ToolbarPanel>
    Test2
</UserControl>
